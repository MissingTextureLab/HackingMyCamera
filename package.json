    "@tsconfig/svelte": "^5.0.8",
    "@webgpu/types": "^0.1.74",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
